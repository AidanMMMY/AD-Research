# 阿里云 ECS 生产环境变量配置
# 复制为 .env 后按需修改，切勿提交到 Git

# ============================================================
# 数据库（容器内自建 PostgreSQL）
# ============================================================
POSTGRES_DB=ad_research
POSTGRES_USER=etf
# ⚠️ 必须修改：生产环境请使用强密码
POSTGRES_PASSWORD=ChangeMeToAStrongPassword123!

# ============================================================
# Redis（容器内自建）
# ============================================================
# 无需额外配置，使用 docker-compose 中定义的 redis 服务

# ============================================================
# 后端应用
# ============================================================
# 环境：production / staging / development
APP_ENV=production

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# Uvicorn worker 数量，建议设置为 CPU 核心数 * 2 + 1
UVICORN_WORKERS=2

# ============================================================
# 外部数据服务 Token
# ============================================================
# Tushare Pro Token（中国 A 股数据），没有可留空，但部分功能不可用
TUSHARE_TOKEN=your_tushare_token_here

# ============================================================
# 认证与安全（生产环境必须修改！）
# ============================================================
# JWT 签名密钥，请使用随机生成的长字符串
# 生成示例：openssl rand -hex 32
AUTH_SECRET_KEY=replace_with_a_random_64_char_hex_string

# 管理员初始用户名（仅首次初始化使用）
AUTH_ADMIN_USERNAME=admin

# 管理员初始密码（仅首次初始化使用，后续可在数据库或管理中修改）
AUTH_ADMIN_PASSWORD=ChangeMeToAStrongAdminPassword!

# Access Token 过期时间（分钟），默认 8 小时
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============================================================
# AI/LLM 配置
# ============================================================
# LLM Provider: deepseek (默认，2026-08 起主链路) | minimax (备用/回滚)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# MiniMax (备用 — 回滚时把 LLM_PROVIDER 改回 minimax 并填 key)
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
# MiniMax 模型 (留空使用默认 minimax-m3)
MINIMAX_MODEL=

# ============================================================
# Internal API (2026-07-23)
# ============================================================
# orchesteate_v2 watchdog → backend /api/v1/internal/orchestrate-alert 鉴权。
# 必须配置：openssl rand -hex 32；不配则 watchdog warning + skip。
INTERNAL_API_TOKEN=
# cron 容器可选别名（默认读 INTERNAL_API_TOKEN）
ORCHESTRATE_ALERT_TOKEN=
# 可选：覆盖 backend URL
ORCHESTRATE_ALERT_URL=http://alloyresearch-backend:8000/api/v1/internal/orchestrate-alert

# ============================================================
# WeChat RSS via wewe-rss (2026-07-27)
# ============================================================
# wewe-rss 容器地址（compose 网络内服务名；独立部署时改成对应 host:port）
WECHAT_RSS_BASE_URL=http://wewe-rss:4000
# 公众号 feed 映射：feed_id:slug:显示名，逗号分隔。
# feed_id 在 wewe-rss 管理台添加公众号后获得（见 20260727-news-source-expansion.md）
WECHAT_RSS_FEED_MAP=
# wewe-rss 管理台密码（可选；设置后 /dash 需要登录）
WEWE_RSS_AUTH_CODE=
